#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python_bin="$project_root/.venv/bin/python"

if [ ! -x "$python_bin" ] ||
  ! "$python_bin" -c "import codex_thread_console" >/dev/null 2>&1
then
  printf '%s\n' "Not installed. Run $project_root/scripts/setup first." >&2
  exit 2
fi

exec "$python_bin" -m codex_thread_console.cli "$@"
